//小结论
ll ff(ll n, ll l, ll k) {
    //n个元素(数量不限),要求用n个元素凑出长度=l的数组
    //两个相同元素之间的间隔要>=k
    //0<=k<n<=l
    //可能的方案数=n!*(n-k)^(l-k)/(n-k)!
    //n-k的l-k次幂
    return N[n] * pw(n - k, l - k) % mod * inv_(N[n - k], mod);
}


